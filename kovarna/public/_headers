# Bezpečnostní hlavičky podle instrukce-web.md.
# Na Workers nahrazuje to, co se na Apache hostingu psalo do .htaccess.
# Soubor se sám neservíruje, Cloudflare ho jen parsuje a aplikuje na odpovědi.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP: default self, fonty hostujeme lokálně ve /fonts/.
  # script-src / connect-src doplň podle konkrétní formulářové služby
  # (form.fapi.cz je to, co se používá na restartmuze.cz — uprav, pokud padne volba jinam).
  # frame-src je připravený pro vloženou Google Mapu, po rozhodnutí klidně zúžit nebo smazat.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://form.fapi.cz; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://form.fapi.cz; frame-src https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://form.fapi.cz

# Fonty se nemění, můžou se cachovat natvrdo.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
